# Your own API key for whichever agent/model you self-check with.
# Askable does not issue shared keys, and never asks you for one.
# Copy to .env, which is gitignored. A key committed to a task
# repository is a rejection: we read the commit history.
#
# gemini-3.8-flash is on the free tier of Gemini CLI and Antigravity,
# which is enough for a self-check screen.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
